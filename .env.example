# Telegram Bot Settings
BOT_TOKEN="replace-with-telegram-bot-token"
SUPPORT_URL="https://t.me/your_support_username"
RATE_LIMIT=0.5
DEBUG=False
INVENTORY_ENCRYPTION_KEY="replace-with-long-random-inventory-secret"
BOT_PUBLIC_URL="https://t.me/VoxMarketBot"
DEFAULT_ADMIN_USER_IDS="1314697368"

# Platega
PLATEGA_MERCHANT_ID="replace-with-platega-merchant-id"
PLATEGA_API_KEY="replace-with-platega-api-key"
PLATEGA_BASE_URL="https://app.platega.io"
PLATEGA_CALLBACK_PATH="/payments/platega/callback"

# Lolz / LZT Market
LOLZ_MARKET_ACCESS_TOKEN=""
LOLZ_MARKET_BASE_URL="https://prod-api.lzt.market"
LOLZ_MARKET_CATEGORIES="telegram"
LOLZ_MARKET_SYNC_LIMIT_PER_CATEGORY=20
LOLZ_BALANCE_USERNAME="princeofscale"
LOLZ_BALANCE_CURRENCY="rub"

# Webhook Server Settings (Optional)
USE_WEBHOOK=False
WEBHOOK_HOST="0.0.0.0"  # use "localhost" if not using Docker
WEBHOOK_PORT=8080
WEBHOOK_BASE_URL="https://example.com"
WEBHOOK_PATH="/webhook"
WEBHOOK_SECRET="replace-with-random-webhook-secret"

# Admin Panel Settings
ADMIN_HOST="0.0.0.0"    # use "localhost" if not using Docker
ADMIN_PORT=5000
DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_PASSWORD="replace-with-strong-admin-password"
SECRET_KEY="replace-with-random-flask-secret-key"
SECURITY_PASSWORD_HASH="pbkdf2_sha512"
SECURITY_PASSWORD_SALT="replace-with-random-password-salt"
SECURITY_REGISTERABLE=False

# Database Settings
DB_HOST="pgbouncer"     # use "localhost" if not using Docker
DB_PORT=5432
DB_USER="tgbot"
DB_PASS="replace-with-strong-database-password"
DB_NAME="bot_db"

# Redis (for FSM and Cache) Settings
REDIS_HOST="redis"      # use "localhost" if not using Docker
REDIS_PORT=6379
REDIS_PASS=

# For Docker Compose file
COMPOSE_PROJECT_NAME=tgbot

# External Services Settings (API Keys for example)
SENTRY_DSN=""
AMPLITUDE_API_KEY=""
POSTHOG_API_KEY=""

# Performance Monitoring System Settings
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="replace-with-strong-grafana-password"
